# ============================================================
# Amali School Portal - mfano wa environment variables
# Nakili faili hili kuwa .env.local kisha jaza values zako:
#   copy .env.example .env.local        (Windows)
#   cp .env.example .env.local          (Linux/Mac)
# KAMWE usiiweke .env.local kwenye git.
# ============================================================

# --- Supabase (LAZIMA) ---------------------------------------
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SIRI - server side pekee. Usiionyeshe kwenye browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ACCESS_TOKEN=your-personal-access-token


# --- Africa's Talking SMS (hiari) ----------------------------
# Bila hizi, SMS module itasema haijasanidiwa lakini app itaendelea.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
# Chaguo la mwisho: sender ID (lazima liwe limeidhinishwa AT)
AFRICASTALKING_SENDER_ID=

# --- Google Analytics (hiari) --------------------------------
NEXT_PUBLIC_GA_ID=

# --- Timetable solver (hiari) --------------------------------
# Bila hii, app inatumia TypeScript fallback solver iliyoko kwenye mradi.
# Weka URL ya Python/OR-Tools service (tazama solver/README.md).
# SOLVER_URL=http://localhost:8001
